# Copy to `.env` and adjust. See SETUP.md for full deployment env.

VITE_WORKER_URL=http://localhost:8787
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Local only: skip Google Sign-In when the Worker `local` env sets the same secret
# (see `env.local.vars.DEV_GOOGLE_AUTH_BYPASS_SECRET` in worker/wrangler.jsonc).
VITE_DEV_GOOGLE_AUTH_BYPASS=true
VITE_DEV_GOOGLE_AUTH_BYPASS_SECRET=local-dev-google-auth-bypass-linkedinpost

# E2E cloud auth bypass: set by CI (GitHub Actions) or setup.py --sync-github-secrets.
# When set, the frontend accepts the same secret value as a valid auth token,
# enabling E2E tests to hit the real deployed worker without Google Sign-In.
# VITE_E2E_BYPASS_SECRET is injected at build time by the CI pipeline.
