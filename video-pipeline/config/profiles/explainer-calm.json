{
  "name": "explainer-calm",
  "_doc": "Plain-language explainer for adults who don't know the jargon: same analogies, calmer motion, clean captions, term cards, progress bar, graded footage, ambient music ducked hard under narration.",
  "font": "poppins",
  "palette": { "bg": "#EEF3FA", "ink": "#1F2A44", "sunny": "#FFC24D", "coral": "#E8574F", "sky": "#2F9BE6", "mint": "#22A98B", "grape": "#5E56D6", "white": "#FFFFFF" },
  "music": { "file": "assets/music/gen_calm.wav", "volume": 0.15 },
  "musicDuck": 0.25,
  "transitions": {
    "default": ["fade", "slide-left"],
    "story_hook": ["slide-bottom"],
    "term": ["wipe-left"],
    "story_payoff": ["fade"],
    "cta": ["fade"]
  },
  "zoom": { "default": [1.02, 1.09], "story_hook": [1.06, 1.16], "story_payoff": [1.06, 1.14], "cta": [1.0, 1.04] },
  "punch": { "story_hook": 0.05 },
  "sparkles": { "default": 0 },
  "captions": { "style": "clean", "size": 62, "bottom": 330 },
  "termStyle": "card",
  "grade": { "saturate": 0.93, "contrast": 1.06, "vignette": 0.3 },
  "progress": true,
  "sfx": { "boundary": { "default": null, "term": "page", "story_payoff": "whoosh" }, "term": "switch" }
}
