{
  "name": "linkedin-generation-worker",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "GEN_DB",
      "database_name": "linkedin-gen-worker-db",
      "database_id": "d531101b-8697-4308-8715-83fa28f5a3ce",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "VARIANTS_KV",
      "id": "e66a947d12934dc799c8dbe34ee3c683"
    },
    {
      "binding": "CLIPS_KV",
      "id": "0e6ed1b702964813a33e13e87edea5d7"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false
    }
  },
  "vars": {},
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.md"],
      "fallthrough": false
    }
  ]
}
