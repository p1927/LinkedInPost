{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "outline.schema.json",
  "description": "Story outline for one episode. Written by outline.py from brief.json + research.json. Consumed by script (L4) and design (L5/D1/M1) lanes.",
  "type": "object",
  "required": ["schema_version", "id", "genre", "beats"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "id": {"type": "string"},
    "genre": {"type": "string"},
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "question_ids", "one_idea", "terms_introduced", "visual_type", "evidence_ids", "target_seconds"],
        "properties": {
          "id":               {"type": "string"},
          "question_ids":     {"type": "array", "items": {"type": "string"}},
          "one_idea":         {"type": "string"},
          "terms_introduced": {"type": "array", "items": {"type": "string"}},
          "terms_used":       {"type": "array", "items": {"type": "string"}},
          "visual_type":      {"type": "string"},
          "evidence_ids":     {"type": "array", "items": {"type": "string"}},
          "target_seconds":   {"type": "number", "minimum": 2},
          "when":             {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
