# Remotion render environment (Chromium deps + FFmpeg). API stages (tts/keyframes/clips) run on the host.
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg ca-certificates fonts-liberation \
    libnss3 libdbus-1-3 libatk1.0-0 libasound2 libxrandr2 libxkbcommon-dev libxfixes3 \
    libxcomposite1 libxdamage1 libatk-bridge2.0-0 libpango-1.0-0 libcairo2 libcups2 libgbm1 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app/remotion-app
COPY remotion-app/package.json remotion-app/package-lock.json* ./
RUN npm install --no-audit --no-fund
COPY remotion-app/ ./
RUN npx remotion browser ensure
ENTRYPOINT ["npx", "remotion"]
